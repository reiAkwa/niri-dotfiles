// Add lines like this to spawn processes at startup.
// Note that running niri as a session supports xdg-desktop-autostart,
// which may be more convenient to use.
// See binds.kdl for more spawn examples.

// Quickshell (bar, launcher, notifications, lock screen) runs as the user unit
// qs.service instead of spawn-at-startup. systemd restarts it if it dies, keeps
// an app-scope OOM kill from taking it down, and relock.sh re-locks the session
// if the shell died while the screen was locked. Enable it with:
//   systemctl --user enable qs.service
// It is pulled in through niri.service.wants/qs.service.

// IME
spawn-at-startup "fcitx5"

// Notification: handled by Quickshell (migrate_from_waybar). Only one process
// can own org.freedesktop.Notifications, so do not start mako concurrently.
// spawn-at-startup "mako"

// Clipboard history: 常驻监听剪贴板，把每次复制的内容存进 cliphist 数据库。
// 配合 binds.kdl 中 Mod+V 的 Quickshell 面板选择历史记录（Mod+V → Quickshell → cliphist decode | wl-copy）。
spawn-at-startup "wl-paste" "--watch" "cliphist" "store"

// Wallpaper
spawn-at-startup "swaybg" "-i" "/home/reiakwa/wallpapers/1-1.jpg" "-m" "fill"

// To run a shell command (with variables, pipes, etc.), use spawn-sh-at-startup:
// spawn-sh-at-startup "qs -c ~/source/qs/MyAwesomeShell"

// Idle management with swayidle:
//   - after 5 minutes (300s): lock the screen
//   - after 10 minutes (600s): turn the monitors off (DPMS)
//   - resume: turn the monitors back on, then lock again (replacing a locker
//     that died while suspended); powering on first also lets niri satisfy the
//     session-lock blank-frame requirement
//   - before-sleep: lock as well, so the screen is never left unlocked across a suspend
spawn-at-startup "swayidle" "-w" "timeout" "300" "/home/reiakwa/.config/quickshell/niri/lock.sh" "timeout" "600" "niri msg action power-off-monitors" "resume" "niri msg action power-on-monitors; /home/reiakwa/.config/quickshell/niri/lock.sh" "before-sleep" "/home/reiakwa/.config/quickshell/niri/lock.sh"
